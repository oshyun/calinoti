    <!-- 시스템 헤더 subText의 다음 일정 라벨. 상대 시간 라벨과 제목의 순서·조합을 언어별로 정한다. -->
    <string name="upcoming_event_header_format">%1$s %2$s</string>
    <!-- 상대 시간 표기. 한국어 CLDR은 other 복수형만 있고 영어는 one/other가 갈리므로 plurals로 둔다.
         시작 1시간 미만 구간은 라벨 대신 실시간 카운트다운이 보여주므로 분·곧 표기는 없다. -->
    <plurals name="event_relative_days">
        <item quantity="other">(%1$d일 뒤)</item>
    </plurals>
    <plurals name="event_relative_hours">
        <item quantity="other">(%1$d시간 뒤)</item>
    </plurals>
    <!-- 시스템 헤더 subText용 상대 시간(괄호 없음). -->
    <plurals name="upcoming_relative_days">
        <item quantity="other">%1$d일후</item>
    </plurals>
    <plurals name="upcoming_relative_hours">
        <item quantity="other">%1$d시간후</item>
    </plurals>
