<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#F2A08E</color>

    <!-- 알림 보조 텍스트 색. 라이트/다크 알림 배경에 맞춰 values-night에서 어긋난다.
         일정 제목 색은 여기에 없다 — 캘린더 색을 NotificationViewsFactory가 런타임에 적용한다. -->
    <color name="notification_text_secondary">#8A000000</color>

    <!-- 알림 카드 배경의 기본값(라이트). One UI는 커스텀 뷰 알림 카드를 표준보다 연하게
         그려 다른 앱 카드와 밝기가 어긋나므로, 카드 배경은 직접 그린다. 값은 화이트 테마의
         기본 알림 카드색이다(2026-09-01 One UI 실기기 캡처에서 픽셀 추출). 다크 기본값은
         values-night에 있다. 설정 화면에서 테마별로 바꿀 수 있고 이 리소스는 미지정 시의
         기본값이다(NotificationViewsFactory.resolveCardBackgroundArgb 참조). -->
    <color name="notification_card_background">#F4F4F4</color>
</resources>
