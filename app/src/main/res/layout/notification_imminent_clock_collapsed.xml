<?xml version="1.0" encoding="utf-8"?>
<!--
  임박 일정 시계 알림 (접힌 상태):
  높이 제한(64dp) 내에서 큰 Chronometer(04:17)와 일정 제목을 한 줄에 조화롭게 보여준다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imminent_clock_collapsed_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/imminent_clock_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_imminent_icon_circle"
        android:src="@drawable/ic_imminent_alarm"
        android:padding="6dp"
        android:contentDescription="@null" />

    <Chronometer
        android:id="@+id/imminent_clock_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/notification_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/imminent_clock_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textColor="@color/notification_text_secondary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
