<?xml version="1.0" encoding="utf-8"?>
<!--
  일정 항목 한 줄: [시간][제목(굵게, 캘린더 색)][위치(회색, 말줄임)]
  날짜 그룹 행(notification_item_day_group)의 일정 열 안에 쌓이는 줄이다 — 시간 있는
  일정의 시간과 종일 일정의 제목 모두 열의 왼쪽에서 시작하므로 두 유형의 왼쪽 x가 일치한다.
  종일 일정은 시간 텍스트를 숨기고, 위치가 없으면 위치 칸을 숨긴다.
  시간·제목·위치 텍스트를 누르면 캘린더 앱에서 해당 일정을 연다. 텍스트가 없는
  오른쪽 여백은 클릭이 없어 알림 전체 contentIntent(지정 캘린더 앱 열기)로 넘어간다.
  위치 칸이 텍스트만큼만 넓어야 여백이 생기므로 weight 확장 대신 wrap_content다 —
  말줄임은 부모가 남은 공간을 제한할 때 그대로 동작한다.
  여백·글자 크기·제목 색은 지정하지 않는다 — AgendaRemoteViewsFactory가 런타임에 적용한다.
  시각과 제목 사이 간격도 RemoteViews가 margin을 못 바꾸므로 시간 뷰의 paddingEnd로 적용한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_event_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <TextView
        android:id="@+id/event_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/notification_text_secondary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/event_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/event_location_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/notification_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
