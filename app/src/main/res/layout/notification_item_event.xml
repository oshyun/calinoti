<?xml version="1.0" encoding="utf-8"?>
<!--
  일정 항목 한 줄: [시간][제목(굵게, 캘린더 색)][임박 카운트다운][위치(회색, 말줄임)]
  날짜 그룹 행(notification_item_day_group)의 일정 열 안에 쌓이는 줄이다. 시간 칸 폭은
  NotificationViewsFactory가 목록에서 가장 넓은 시각 텍스트로 런타임에 고정한다(API 31+,
  그 전 버전은 wrap_content) — 시각 글자수와 무관하게 제목의 시작 x가 같다. 종일 일정은
  시간 텍스트만 숨기고(GONE 대신 INVISIBLE) 칸은 남겨 제목을 다른 행과 같은 x에서
  시작한다. 위치가 없으면 위치 칸을 숨긴다.
  임박 카운트다운은 시작이 1시간 미만으로 남은 시간 있는 일정만 보이는 Chronometer다 —
  시스템이 실시간으로 줄여 그려 갱신 없이도 초 단위로 정확하다(NotificationViewsFactory가
  setChronometer로 걸고 평소엔 숨긴다).
  시간·제목·위치 텍스트를 누르면 캘린더 앱에서 해당 일정을 연다. 텍스트가 없는
  오른쪽 여백은 클릭이 없어 알림 전체 contentIntent(지정 캘린더 앱 열기)로 넘어간다.
  위치 칸이 텍스트만큼만 넓어야 여백이 생기므로 weight 확장 대신 wrap_content다 —
  말줄임은 부모가 남은 공간을 제한할 때 그대로 동작한다.
  여백·글자 크기·제목 색은 지정하지 않는다 — NotificationViewsFactory가 런타임에 적용한다.
  시각과 제목 사이 간격도 RemoteViews가 margin을 못 바꾸므로 시간 뷰의 paddingEnd로 적용한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_event_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <TextView
        android:id="@+id/event_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/notification_text_secondary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/event_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <Chronometer
        android:id="@+id/event_relative_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:visibility="gone" />

    <TextView
        android:id="@+id/event_location_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/notification_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
