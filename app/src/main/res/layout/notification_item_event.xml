<?xml version="1.0" encoding="utf-8"?>
<!--
  일정 항목 한 줄: [시간(오른쪽 정렬 칸)][제목(굵게, accent 색)][위치(회색, 말줄임)]
  종일 일정은 시간 칸을 숨기고, 위치가 없으면 위치 칸을 숨긴다.
  행을 누르면 캘린더 앱에서 해당 일정을 연다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_event_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/event_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="52dp"
        android:gravity="end"
        android:layout_marginEnd="12dp"
        android:textSize="13sp"
        android:textColor="@color/notification_text_secondary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/event_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/notification_text_accent"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/event_location_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textColor="@color/notification_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
