<?xml version="1.0" encoding="utf-8"?>
<!--
  일정 항목 한 줄: [시간][제목(굵게, 캘린더 색)][위치(회색, 말줄임)]
  시간은 왼쪽 여백 바로 뒤에 왼쪽 정렬로 온다 — 종일 일정의 제목도 같은 여백에서
  시작하므로 두 유형의 맨 왼쪽 여백이 eventStartPaddingDp 하나로 일치한다.
  종일 일정은 시간 텍스트를 숨기고, 위치가 없으면 위치 칸을 숨긴다.
  행을 누르면 캘린더 앱에서 해당 일정을 연다.
  여백·글자 크기·제목 색은 지정하지 않는다 — AgendaRemoteViewsFactory가 런타임에 적용한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_event_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <TextView
        android:id="@+id/event_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="@color/notification_text_secondary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/event_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/event_location_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/notification_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
