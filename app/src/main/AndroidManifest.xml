<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 배터리 최적화 제외를 묻는 시스템 확인 다이얼로그를 띄우기 위해 필요하다.
         절전 중 알람 스로틀(앱당 15분 간격)과 프로세스 정리를 면제해 갱신을 지키게 한다. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 알림의 일정 줄을 눌러 캘린더 앱의 일정 상세를 열기 전, 런타임에 처리 앱이 있는지
         확인한다. API 30+ 패키지 가시성 제한 때문에 이 선언이 없으면 확인이 항상 실패한다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
    </queries>

    <application
        android:name=".AgendaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalendarStatus">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 알람 갱신 예약과 재부팅 복원(BOOT_COMPLETED)을 같은 경로로 받는다.
             시스템 전용 브로드캐스트와 명시적 인텐트만 다루므로 외부 노출 불필요. -->
        <receiver
            android:name=".scheduling.AgendaRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
